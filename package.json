{
  "name": "rose-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:start": "node docs/scripts/dev.mjs start",
    "dev:status": "node docs/scripts/dev.mjs status",
    "dev:stop": "node docs/scripts/dev.mjs stop",
    "dev:logs": "node docs/scripts/dev.mjs logs",
    "doctor:repo": "node docs/scripts/doctor.mjs",
    "clean": "node docs/scripts/clean.mjs",
    "promote": "node docs/scripts/promote.mjs",
    "repo:status": "node docs/scripts/repo-status.mjs",
    "review:prep": "node docs/scripts/review-prep.mjs",
    "ci:inspect": "node docs/scripts/ci-inspect.mjs",
    "pr:open": "node docs/scripts/pr-open.mjs",
    "affected": "node docs/scripts/affected.mjs",
    "guard": "node docs/scripts/guard.mjs",
    "worktree:new": "node docs/scripts/worktree.mjs new",
    "worktree:list": "node docs/scripts/worktree.mjs list",
    "worktree:remove": "node docs/scripts/worktree.mjs remove",
    "sync": "node docs/scripts/sync.mjs",
    "expo:url": "node docs/scripts/expo.mjs url",
    "expo:qr": "node docs/scripts/expo.mjs qr",
    "deps:check": "node docs/scripts/deps-check.mjs",
    "release": "node docs/scripts/release.mjs",
    "docs:check": "node docs/scripts/docs-check.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "quality": "pnpm quality:duplication && pnpm quality:unused",
    "quality:duplication": "jscpd . --config .jscpd.json",
    "quality:unused": "knip --include files,dependencies --max-issues 0 --no-config-hints",
    "verify": "pnpm format:check && pnpm lint && pnpm check-types && pnpm test && pnpm quality && pnpm docs:check && pnpm build"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,md,mdx,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "knip": "^6.46.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11"
  }
}
